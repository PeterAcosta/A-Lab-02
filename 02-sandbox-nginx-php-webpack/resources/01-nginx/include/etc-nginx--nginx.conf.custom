## Archivo de configuracion de Peter

user  nginx;
worker_processes  auto;


# Niveles de mensajes de error: debug,info,notice,warn o warning,error,critical,alert,emergency
# Para produccion: error,warn, notice
# Para desarrollo: debug, info  
error_log  /var/log/nginx/01-nginx-error.log debug;     ## desarrollo
# error_log  /var/log/nginx/01-nginx-error.log notice;    ## produccion
pid        /var/run/nginx.pid;



events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;

    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" "$http_x_forwarded_for"';
    log_format  prod3 '$time_iso8601 - $remote_addr - [$status] - [$body_bytes_sent] - "$remote_user" - "$request" - [$http_referer] - "$http_user_agent" - [$http_x_forwarded_for]';
    
    access_log  /var/log/nginx/01-nginx-access.log  prod3;
    
    sendfile        on;
    
    #tcp_nopush     on;
    
    keepalive_timeout  65;
    
    #gzip  on;

    # Peter: para permitir subir archivos grandes 
    client_max_body_size 250M;
    
    

    
    include /etc/nginx/conf.d/*.conf;
    # include /etc/nginx/sites-enabled/*;

}
